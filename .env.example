# Synthetic placeholders. Copy to .env and configure before starting.
VAULT_HOST_PATH=/srv/example-vault
VAULT_STATE_PATH=/srv/example-vault-mcp-state
VAULT_UID=10001
VAULT_GID=10001
VAULT_WRITE_FOLDER=Agents
VAULT_INSTRUCTIONS_PATH=AGENTS.md
CF_ACCESS_TEAM=example-team
CF_ACCESS_AUD=replace-with-application-aud
VAULT_ALLOWED_USERS=owner@example.invalid=read,agent_write
VAULT_ALLOWED_SERVICES=
# Choose a published version; pin its sha256 digest for production.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:replace-with-verified-version
TUNNEL_TOKEN_FILE=/srv/example-vault-mcp-secrets/tunnel-token
